<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/pos_bg_dark">

    <!-- LEVA STRAN (40%): Seznam vrstic naročila + Statusna vrstica -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.4"
        android:orientation="vertical"
        android:paddingEnd="2dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvNarociloItems"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="2dp"
            android:background="#222222" />

        <TextView
            android:id="@+id/tvMizaStatus"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:background="#111111"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:text="M: Miza 5  -  Zn: 4,00 / Pl: 0,00" />
    </LinearLayout>

    <!-- DESNA STRAN (60%): Krmilni gumbi + Hitre tipke / Cenik -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.6"
        android:orientation="vertical">

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="5"
            android:rowCount="3"
            android:alignmentMode="alignBounds"
            android:useDefaultMargins="false"
            android:padding="1dp">

            <!-- Vrstica 1 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNavMize"
                style="@style/PosButtonStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_columnWeight="1"
                android:layout_gravity="fill"
                android:backgroundTint="@color/pos_btn_normal"
                android:text="@string/btn_mize"
                android:textColor="#FFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNavRacuni"
                style="@style/PosButtonStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_columnWeight="1"
                android:layout_gravity="fill"
                android:backgroundTint="@color/pos_btn_normal"
                android:text="@string/btn_racuni"
                android:textColor="#FFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNavNarociSelf"
                style="@style/PosButtonStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_columnWeight="1"
                android:layout_gravity="fill"
                android:backgroundTint="@color/pos_accent_blue"
                android:text="@string/btn_naroci"
                android:textColor="#FFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNavPlacila"
                style="@style/PosButtonStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_columnWeight="1"
                android:layout_gravity="fill"
                android:backgroundTint="@color/pos_btn_normal"
                android:text="@string/btn_placila"
                android:textColor="#FFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOdjava"
                style="@style/PosButtonStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_columnWeight="1"
                android:layout_gravity="fill"
                android:backgroundTint="@color/pos_accent_red"
                android:text="@string/btn_odjava"
                android:textColor="#FFFFFF" />

            <!-- Vrstica 2 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBrisanje"
                style="@style/PosButtonStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_columnWeight="1"
                android:layout_gravity="fill"
                android:backgroundTint="@color/pos_btn_normal"
                android:text="Brisanje"
                android:textColor="#FFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCenikTipke"
                style="@style/PosButtonStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_columnWeight="1"
                android:layout_gravity="fill"
                android:backgroundTint="@color/pos_btn_normal"
                android:text="CENIK/\nTIPKE"
                android:textColor="#FFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHodi"
                style="@style/PosButtonStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_columnWeight="1"
                android:layout_gravity="fill"
                android:backgroundTint="@color/pos_btn_normal"
                android:text="Hod-i"
                android:textColor="#FFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPreklopiCenik"
                style="@style/PosButtonStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_columnWeight="1"
                android:layout_gravity="fill"
                android:backgroundTint="@color/pos_btn_normal"
                android:text="PREKLOPI\nCENIK"
                android:textColor="#FFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNarociPost"
                style="@style/PosButtonStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_columnWeight="1"
                android:layout_gravity="fill"
                android:backgroundTint="@color/pos_accent_green"
                android:text="NAROČI"
                android:textColor="#FFFFFF" />

            <!-- Vrstica 3 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPopust"
                style="@style/PosButtonStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_columnWeight="1"
                android:layout_gravity="fill"
                android:backgroundTint="@color/pos_btn_normal"
                android:text="Popust"
                android:textColor="#FFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGostHotela"
                style="@style/PosButtonStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_columnWeight="1"
                android:layout_gravity="fill"
                android:backgroundTint="@color/pos_btn_normal"
                android:text="GOST\nHOTELA"
                android:textColor="#FFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKreditnaPos"
                style="@style/PosButtonStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_columnWeight="1"
                android:layout_gravity="fill"
                android:backgroundTint="@color/pos_btn_normal"
                android:text="KREDITNA K\nPOS"
                android:textColor="#FFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKredRocno"
                style="@style/PosButtonStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_columnWeight="1"
                android:layout_gravity="fill"
                android:backgroundTint="@color/pos_btn_normal"
                android:text="KRED. K\nROCNO"
                android:textColor="#FFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGotovina"
                style="@style/PosButtonStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_columnWeight="1"
                android:layout_gravity="fill"
                android:backgroundTint="@color/pos_btn_normal"
                android:text="Gotovina"
                android:textColor="#FFFFFF" />
        </GridLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvQuickKeys"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="1dp"
            android:background="#1B1B1B" />

        <LinearLayout
            android:id="@+id/llCenikContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#263238"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/llCenikSearch"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#37474F"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔍 "
                    android:textColor="#CCCCCC"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/etSearchCenik"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Išči artikel po nazivu ali kodi..."
                    android:textColor="#FFFFFF"
                    android:textColorHint="#90A4AE"
                    android:textSize="14sp"
                    android:singleLine="true"
                    android:imeOptions="actionSearch" />

                <ImageButton
                    android:id="@+id/btnClearSearch"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Počisti iskanje"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="#B0BEC5" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCenikList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="2dp"
                android:background="#111111" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
